#!/bin/sh
# Blocks any commit that would publish private company data.
if git diff --cached --name-only | grep -qx "company_profile.json"; then
  echo "BLOCKED: company_profile.json is PRIVATE and must never be committed."
  exit 1
fi
PY=$(command -v python || command -v python3)
if [ -z "$PY" ]; then
  echo "BLOCKED: Python not found, so the privacy check could not run."
  exit 1
fi
"$PY" tests/test_privacy.py || { echo "BLOCKED: a private name was found in a file that would be published. Fix it, then commit again."; exit 1; }
